<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>world.brainstorm.divinebot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOU/Documents/Tapestry/divine-videos/scripts/launchd/run-divinebot.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/Documents/Tapestry/divine-videos</string>
  <!--
    launchd does not read your shell exports and does not expand ~ or $HOME, so any setting the job
    needs goes here with absolute paths. Uncomment what you use:
    DIVINEBOT_KEY_FILE when the key is not at ~/.config/divine-videos/curator.key, and
    DIVINEBOT_PASSPHRASE_FILE when the key is an ncryptsec (the file must have mode 600).
  <key>EnvironmentVariables</key>
  <dict>
    <key>DIVINEBOT_KEY_FILE</key>
    <string>/Users/YOU/.config/divine-videos/curator.key</string>
    <key>DIVINEBOT_PASSPHRASE_FILE</key>
    <string>/Users/YOU/.config/divine-videos/curator.pass</string>
  </dict>
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Documents/Tapestry/divine-videos/state/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Documents/Tapestry/divine-videos/state/logs/launchd.err.log</string>
</dict>
</plist>
